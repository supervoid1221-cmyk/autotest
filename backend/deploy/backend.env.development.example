# 仅用于开发机，禁止复制到生产服务器。
DJANGO_ENV=development
DJANGO_DEBUG=true

# 开发模式可不配置密钥，系统会使用仅限本地的固定开发密钥。
# DATA_ENCRYPTION_KEYS 留空时会根据本地开发密钥派生，不能用于生产数据。
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOW_ALL=true
DJANGO_CORS_ALLOW_CREDENTIALS=false
DJANGO_API_DOCS_ENABLED=true

DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0

DATABASE_ENGINE=sqlite
REPORT_PUBLIC_BASE_URL=http://localhost:8001
DYNAMIC_FUNCTION_SOCKET=/run/dynamic-functions/worker.sock
DYNAMIC_FUNCTION_TIMEOUT_SECONDS=3
DYNAMIC_FUNCTION_MEMORY_MB=128
DYNAMIC_FUNCTION_ALLOW_LOCAL_FALLBACK=true
DJANGO_Q_WORKERS=1
