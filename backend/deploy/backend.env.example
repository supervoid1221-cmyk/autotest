# 运行环境：development / production
DJANGO_ENV=production
DJANGO_DEBUG=false

# 生产必填：至少 50 位随机字符。
# 生成方式：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=请替换为强随机密钥

# 生产必填：Fernet 密钥。密钥轮换时按“新密钥,旧密钥”排列。
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEYS=请替换为Fernet密钥

# 只填写实际访问域名/IP，多个使用英文逗号分隔，禁止 *。
DJANGO_ALLOWED_HOSTS=test.example.com

# Origin 必须包含协议；多个使用英文逗号分隔。
DJANGO_CORS_ALLOW_ALL=false
DJANGO_CORS_ALLOWED_ORIGINS=https://test.example.com
DJANGO_CORS_ALLOW_CREDENTIALS=false
DJANGO_CSRF_TRUSTED_ORIGINS=https://test.example.com

# 推荐生产启用 HTTPS 并保持以下三项为 true。
# 当前若仍使用 HTTP，必须显式改为 false，否则浏览器无法正常使用 Cookie。
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# 生产默认不暴露 Swagger/Redoc。
DJANGO_API_DOCS_ENABLED=false

DATABASE_ENGINE=mysql
DATABASE_NAME=test_platform
DATABASE_USER=test_platform
DATABASE_PASSWORD=请填写数据库密码
DATABASE_HOST=
DATABASE_PORT=
DATABASE_SOCKET=/host/run/mysqld/mysqld.sock
DATABASE_CONN_MAX_AGE=60

REPORT_PUBLIC_BASE_URL=https://test.example.com
DJANGO_Q_WORKERS=2
